{
  "name": "govflow-backend",
  "version": "0.1.0",
  "description": "GovFlow Node.js + Express + MongoDB backend",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext js src/server.js",
    "start": "node src/server.js",
    "seed": "node scripts/seed.js",
    "normalize:departments": "node scripts/normalize-departments.js",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1076.0",
